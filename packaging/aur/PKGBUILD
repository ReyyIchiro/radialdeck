# Maintainer: Raihan <https://github.com/ReyyIchiro>
# Contribute through the upstream repository:
#   https://github.com/ReyyIchiro/radialdeck
# The publisher of the AUR package must replace the maintainer line with a
# reachable contact address before pushing to the AUR.

pkgname=radial-deck
# `update-pkgbuild.sh` rewrites pkgver and sha256sums for one release. Keep
# both in sync with Cargo.toml; `makepkg --printsrcinfo` is generated.
pkgver=0.3.0
pkgrel=1
pkgdesc="Radial file conversion and project folder launcher for Wayland"
arch=('x86_64' 'aarch64')
url="https://github.com/ReyyIchiro/radialdeck"
license=('MIT')
depends=(
    'gtk4'
    'gtk4-layer-shell'
    'xdg-desktop-portal'
    'xdg-utils'
    'hicolor-icon-theme'
)
optdepends=(
    'imagemagick: image tools, collages, and PDF output'
    'ffmpeg: video and audio conversions and trim/split/snapshot tools'
    'poppler: PDF to image/text and page-level PDF tools'
    'ghostscript: PDF compression'
    'libreoffice-fresh: document, slide, and spreadsheet conversions'
    'pandoc: Markdown conversion'
    '7zip: 7Z and RAR extraction'
    'kdeconnect: Send action over the local network'
)
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver/radialdeck-$pkgver.tar.gz")
# Product of the upstream v$pkgver tag. Regenerate with
#   curl -L "$url/archive/v$pkgver/radialdeck-$pkgver.tar.gz" | sha256sum
sha256sums=('UPDATE_ME_FROM_THE_v0.3.0_TAG')

prepare() {
    cd "radialdeck-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "radialdeck-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "radialdeck-$pkgver"
    cargo test --frozen --workspace
}

package() {
    cd "radialdeck-$pkgver"

    install -Dm755 "target/release/radial-deck" \
        "$pkgdir/usr/bin/radial-deck"

    install -Dm644 "packaging/io.github.raihan.RadialDeck.desktop" \
        "$pkgdir/usr/share/applications/io.github.raihan.RadialDeck.desktop"

    install -Dm644 "packaging/io.github.raihan.RadialDeck.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.raihan.RadialDeck.svg"

    install -Dm644 "packaging/io.github.raihan.RadialDeck.servicemenu.desktop" \
        "$pkgdir/usr/share/kio/servicemenus/io.github.raihan.RadialDeck.desktop"

    # Documentation users are pointed at from the app and the repository.
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/manual.md "$pkgdir/usr/share/doc/$pkgname/manual.md"
}
